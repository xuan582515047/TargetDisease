# ⚠️ 重要：下面两个占位值 change-me 必须在首次启动前替换为真实随机值。
# 若使用 change-me 启动，后端会因密钥不安全而拒绝启动。
# 用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成
APP_SECRET_KEY=change-me
# AES-GCM 主密钥：32 字节 base64，用 `python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"` 生成
# ⚠️ 该密钥一旦变更，用户已保存的模型 API Key 将无法解密，请务必备份本文件。
APP_CREDENTIAL_MASTER_KEY=change-me

# ---- 以下变量仅生产编排 docker-compose.prod.yml 使用 ----
# 数据库凭据（不要再使用 postgres/postgres 这类弱口令）
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=app

# 前端监听：默认只绑定本机 127.0.0.1，由宿主 Nginx 反代。
# 若暂无域名、想直接用 IP 访问，把 FRONTEND_BIND 改为 0.0.0.0。
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3001
